config_version=5

[GD-Sync]

version="0.14"

[application]

config/name="Pigeon fall of empire pre-alpha"
config/description="In this game, you play as a pigeon who is tired of being bullied by animals and other birds. He decides to kill a lion to show everyone that birds, especially pigeons, are capable of great deeds. However, he will face numerous enemies and puzzles that require the use of various gameplay mechanics. The game's unique feature is that each location introduces new mechanics, making the gameplay incredibly engaging and interesting.

Development start: February 28, 2026

Current game status: Pre-alpha"
config/version="0.2"
run/main_scene="uid://ds6n3l4puohop"
config/features=PackedStringArray("4.7", "GL Compatibility")
